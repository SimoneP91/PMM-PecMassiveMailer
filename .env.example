# pecmailer: one container = one tenant + one of its mailboxes.
#
# Copy to .env to run `npm start` or `npm run cli` on this machine. The local
# Docker stack does not read it: docker-compose.yml sets its own values. In
# Kubernetes the same variables come from a ConfigMap and, for the passwords
# and RABBITMQ_URL, from a Secret.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Who this container is (codes: lower-case letters, digits and "-")
PECMAILER_TENANT=serfin
PECMAILER_MAILBOX=serfin-aruba
# aruba | legalmail | infocert | custom
PECMAILER_PROVIDER=aruba
PECMAILER_FROM_ADDRESS=solleciti@pec.serfin.example
PECMAILER_FROM_NAME=Serfin - Recupero Crediti

# SMTP. Host, port and security come from the provider preset unless set.
PECMAILER_SMTP_PASSWORD=change-me
# PECMAILER_SMTP_USERNAME=        defaults to the from address (Legalmail wants the M... account code)
# PECMAILER_SMTP_HOST=
# PECMAILER_SMTP_PORT=
# PECMAILER_SMTP_SECURITY=        none | starttls | tls
# PECMAILER_SMTP_TIMEOUT_SECONDS=60

# IMAP: the copy in the Sent folder and the receipts. Username and password default to the SMTP ones.
# PECMAILER_IMAP_ENABLED=true
# PECMAILER_IMAP_USERNAME=
# PECMAILER_IMAP_PASSWORD=
# PECMAILER_IMAP_HOST=
# PECMAILER_IMAP_PORT=
# PECMAILER_IMAP_SECURITY=
# PECMAILER_IMAP_SENT_FOLDER=     from the preset (Aruba INBOX.Inviata, Legalmail INBOX/Spedite)
# PECMAILER_IMAP_RECEIPTS_FOLDER=INBOX

# Sending
# PECMAILER_PER_MINUTE=60                         0 = no pace
# PECMAILER_MAX_MESSAGE_BYTES=31457280
# PECMAILER_RETRY_BACKOFF_SECONDS=60,300,900      at most 25 minutes in all (RabbitMQ's 30-minute limit)
# PECMAILER_UNVERIFIED_RECIPIENTS=reject          reject | send, when a domain cannot be classified
# PECMAILER_PEC_DOMAINS=                          comma-separated, added to the built-in lists
# PECMAILER_PEC_MX_SUFFIXES=
# PECMAILER_NON_PEC_DOMAINS=
# PECMAILER_NON_PEC_MX_SUFFIXES=

# Receipts
# PECMAILER_RECEIPTS_POLL_SECONDS=60
# PECMAILER_RECEIPTS_LOOKBACK_HOURS=72            how far back each start re-reads (the container keeps nothing)
# PECMAILER_RECEIPTS_MAX_PER_POLL=200

# RabbitMQ (the local stack's broker, reached from this machine)
RABBITMQ_URL=amqp://pecmailer:pecmailer@localhost:5672
# PECMAILER_QUEUE_PREFIX=pecmailer                queues: <prefix>.<tenant>.<mailbox>.in / .out / .dead
# PECMAILER_DECLARE_QUEUES=true                   false when the infrastructure creates them
# PECMAILER_QUEUE_DELIVERY_LIMIT=5

# Kubernetes probes (0 = no probe server)
# HEALTH_HOST=0.0.0.0
HEALTH_PORT=3001
