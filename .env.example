# pecmailer - environment variables
#
# Copy to .env for docker compose, or export them in the shell. Every variable
# the service reads is listed here, with its default where one exists. The
# process refuses to start when a required variable is missing or malformed:
# see src/config/env.schema.ts for the exact rules.

# development | test | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Human readable logs on the terminal (development only; production always logs JSON)
LOG_PRETTY=true

# HTTP API
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Serve Swagger UI on /docs. The service runs on a VPN, so the docs are open.
SWAGGER_ENABLED=true

# MongoDB. directConnection=true lets a single node replica set be reached
# without hostname discovery (needed for transactions and change streams).
MONGODB_URI=mongodb://localhost:27017/pecmailer?directConnection=true

# Tenants, mailboxes and API key hashes. No secrets inside: see config/pecmailer.example.yaml
CONFIG_FILE=./config/pecmailer.yaml

# Where attachments, sent EMLs and receipts are stored (a volume in production)
STORAGE_DIR=./storage

# Worker only. Liveness/readiness probes on this port (0 = disabled), and the
# name the worker signs mailbox leases with (default: hostname:pid).
WORKER_HEALTH_PORT=3001
# WORKER_ID=worker-1

# Mailbox passwords, one variable per mailbox: MAILBOX_<CODE>_PASSWORD with the
# code upper-cased and every non alphanumeric character turned into '_'.
# A mailbox declared in the config file whose password is missing stops the boot.
MAILBOX_SERFIN_ARUBA_PASSWORD=change-me

# Webhook signing secrets, referenced by name from the config file (tenants[].webhook.secretEnv)
WEBHOOK_SERFIN_SECRET=change-me
