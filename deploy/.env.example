# pecmailer in production: the settings and secrets docker-compose.yml reads.
#
# Copy to .env next to docker-compose.yml, fill in every value, and make it
# readable by its owner only:
#   cp .env.example .env && chmod 600 .env
# .env holds passwords: never commit it, never send it by e-mail or chat.
# `docker compose config --quiet` fails, naming the variable, while one is empty.

# The pecmailer image in the company's container registry, with its version,
# e.g. myregistry.azurecr.io/pecmailer:0.6.1. To move to another version:
# change it here, then `docker compose pull && docker compose up -d --wait`.
PECMAILER_IMAGE=

# RabbitMQ's image. Docker Hub's by default; set it only when the server can
# reach the company registry and not Docker Hub, to a copy published there.
# RABBITMQ_IMAGE=rabbitmq:4.3-management

# RabbitMQ: the user the containers log in with (the broker creates it at its
# first start). Letters and digits only in the password: it is also written
# inside the RabbitMQ URL, where characters such as @ : / would break it.
RABBITMQ_USER=pecmailer
RABBITMQ_PASSWORD=

# The client's code: lower-case letters, digits and "-", e.g. serfin.
# Queue names are pecmailer.<tenant>.<mailbox>.in / .out / .dead
PECMAILER_TENANT=

# PECs sent per minute by each mailbox. Kept low while the CRM is new:
# a CRM bug that publishes hundreds of PECs shows up after a few sends.
PECMAILER_PER_MINUTE=5

# The Legalmail mailbox.
# Mailbox code: lower-case letters, digits and "-", e.g. serfin-legalmail
LEGALMAIL_MAILBOX=
# The PEC address the PECs are sent from
LEGALMAIL_ADDRESS=
# The sender's name recipients see
LEGALMAIL_FROM_NAME=
# The M... account code InfoCert gives, not the address
LEGALMAIL_USER=
LEGALMAIL_PASSWORD=
