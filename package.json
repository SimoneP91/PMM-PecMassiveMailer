{
  "name": "pecmailer",
  "version": "0.6.0",
  "description": "PEC (certified e-mail) sending service: one container per tenant and mailbox, driven by RabbitMQ queues",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "cli": "node --env-file-if-exists=.env dist/main.cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "local:publish": "node --env-file=examples/local.env dist/main.cli.js publish",
    "local:outcomes": "node --env-file=examples/local.env dist/main.cli.js outcomes"
  },
  "dependencies": {
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "pino": "^9.7.0",
    "rabbitmq-client": "^5.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.0",
    "rimraf": "^6.0.1",
    "smtp-server": "^3.19.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
