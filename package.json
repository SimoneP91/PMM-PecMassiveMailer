{
  "name": "pecmailer",
  "version": "0.5.0",
  "description": "Multi-tenant PEC (certified e-mail) sending microservice",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev:api": "nest start --watch --entryFile main.api --exec \"node --env-file-if-exists=.env\"",
    "dev:worker": "nest start --watch --entryFile main.worker --exec \"node --env-file-if-exists=.env\"",
    "start:api": "node --env-file-if-exists=.env dist/main.api.js",
    "start:worker": "node --env-file-if-exists=.env dist/main.worker.js",
    "cli": "node --env-file-if-exists=.env dist/main.cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "openapi:export": "node dist/tools/export-openapi.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.0.5",
    "js-yaml": "^5.4.2",
    "mailparser": "^3.9.28",
    "mongoose": "^9.10.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.10",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.0",
    "rimraf": "^6.0.1",
    "smtp-server": "^3.19.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
